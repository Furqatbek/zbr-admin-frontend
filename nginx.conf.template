# Rendered at container start by the nginx image's envsubst step:
# ${BACKEND_HOST} is substituted from the environment (default set in
# docker-compose.yml). NGINX_ENVSUBST_FILTER is set to BACKEND_HOST so ONLY
# this variable is replaced and nginx's own $variables are left untouched.
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # DNS for resolving the external backend host. In docker compose, 127.0.0.11
    # is the embedded DNS which also forwards public lookups (e.g. zbrr.uz).
    # Using a variable in proxy_pass defers resolution to request time, so nginx
    # boots even if the backend is briefly unreachable (returns 502 instead of
    # failing to start).
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Live backend host (env-configurable — prod vs staging). The browser calls
    # same-origin /api and /ws; nginx reverse-proxies to this HTTPS origin so
    # there is no cross-origin/CORS.
    set $backend https://${BACKEND_HOST};

    # API proxy -> https://${BACKEND_HOST}/api/v1/...
    location /api {
        proxy_pass $backend;
        proxy_http_version 1.1;
        # TLS to an external HTTPS upstream needs SNI + the backend's own Host.
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        # This is a same-origin reverse proxy, so drop the browser's Origin
        # header before forwarding. Otherwise the backend's CORS check sees a
        # foreign origin (e.g. http://localhost:3000) and rejects with 403. An
        # empty value tells nginx not to send the header at all — matching a
        # direct server-to-server call, which the backend accepts.
        proxy_set_header Origin "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 90;
    }

    # WebSocket proxy -> wss://${BACKEND_HOST}/ws
    location /ws {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        # Same as /api: strip the browser Origin so the backend's WS handshake
        # origin check treats this as a same-origin request.
        proxy_set_header Origin "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 86400;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Disable caching for index.html
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
